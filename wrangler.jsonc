{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-page",
  "main": "worker.js",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "vars": {
    // Which Bing region's photo of the day to show, e.g. en-US, en-GB, en-IN
    "BING_MARKET": "en-US"
  }
}
